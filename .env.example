# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Every variable here is read by code in src/tn_accountability/config.py.

# --- Supabase / Postgres -----------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" (port 5432) URI for migrations and bulk loads.
# Password is the database password you set when creating the project.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL and keys (used by the Evidence site in Phase 8).
SUPABASE_URL=https://<project-ref>.supabase.co
# Safe to expose in a browser; row-level security governs what it can read.
SUPABASE_ANON_KEY=
# NEVER expose in a browser or commit. Server-side ingest jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# --- LegiScan ----------------------------------------------------------------
# Free key: https://legiscan.com/legiscan -> request API key.
LEGISCAN_API_KEY=

# --- Cloudflare (Phase 8 deploy) ---------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Deploy hook URL used by the Phase 7 ingest jobs to trigger a site rebuild.
CLOUDFLARE_DEPLOY_HOOK_URL=

# --- Runtime -----------------------------------------------------------------
# Where raw downloads land. Keep inside the repo so paths in docs stay valid.
DATA_RAW_DIR=data/raw
# Default lookback window in days for the pre-introduction contribution analysis.
LOOKBACK_DAYS=90
